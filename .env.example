# Bu faylni .env nomi bilan nusxalab, qiymatlarni to'ldiring. .env GitHub'ga yuklanmaydi.
BOT_TOKEN=
# Webhook rejimi uchun (bo'sh bo'lsa polling ishlaydi), masalan: https://your-app.onrender.com
WEBHOOK_HOST=
# Ixtiyoriy: Telegram webhook so'rovlarini tekshirish uchun maxfiy kalit (A-Z, a-z, 0-9, _ -)
WEBHOOK_SECRET=
PORT=10000
# Talabalar ro'yxati va baza fayllari
EXCEL_FILE=data.xlsx
DATABASE_FILE=bot_data.db

# Ro'yxatdan o'tganlarni Google Sheets'ga yozish (README dagi yo'riqnoma bo'yicha).
# Bo'sh qoldirilsa, bu funksiya o'chiq bo'ladi.
SHEETS_WEBHOOK_URL=
SHEETS_SECRET=
SHEETS_SYNC_INTERVAL=60

# Majburiy kanal (standart: @kiu_uz; o'chirish uchun: off). Bot shu kanalda administrator bo'lishi kerak.
REQUIRED_CHANNEL=@kiu_uz
# Kanal havolasi (yopiq kanal bo'lsa taklif havolasi). Bo'sh bo'lsa @username dan olinadi.
REQUIRED_CHANNEL_URL=

# Rassilka qila oladigan adminlarning Telegram ID'lari (vergul bilan). ID'ni botga /id yozib bilasiz.
ADMIN_IDS=1144976151
